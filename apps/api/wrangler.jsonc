{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nauri-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // better-auth usa APIs de Node (crypto, buffer) por baixo.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // App web e API no mesmo Worker e na mesma origem: sem cookie entre sites
  // (que o Safari bloqueia) e sem CORS em produção. O build do app
  // (`npm run build:web` na raiz) precisa rodar antes do deploy.
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    // Rota sem arquivo cai no app, que decide o que mostrar.
    "not_found_handling": "single-page-application",
    // `/__scheduled` só existe no `wrangler dev --test-scheduled`, para
    // disparar o cron à mão; em produção o Hono responde 404.
    "run_worker_first": ["/api/*", "/health", "/__scheduled"]
  },
  // Cria sozinho o registro de DNS e o certificado de nauri.app.
  "routes": [{ "pattern": "nauri.app", "custom_domain": true }],
  // Só nauri.app. Um segundo endereço *.workers.dev seria outra origem: o
  // cookie de sessão e o APP_URL não valeriam lá. (A conta precisa ter um
  // subdomínio workers.dev mesmo assim: a Cloudflare o exige para aceitar
  // Cron Triggers.)
  "workers_dev": false,
  // Sem isto o `wrangler dev` usa o host da rota acima e reescreve o Origin
  // de localhost:8787 para http://nauri.app, e o Better Auth recusa o login
  // feito na mesma origem com INVALID_ORIGIN.
  "dev": { "host": "localhost:8787" },

  // Valores de produção. No `wrangler dev`, os de `.dev.vars` têm prioridade.
  // Os segredos (DATABASE_URL, BETTER_AUTH_SECRET, RESEND_API_KEY,
  // INVITE_CODE) vão por `wrangler secret put`. Os do Open Finance também
  // (PLUGGY_CLIENT_ID, PLUGGY_CLIENT_SECRET, PLUGGY_ITEM_ID,
  // OPEN_FINANCE_USER_ID): o repositório é público.
  "vars": {
    "APP_URL": "https://nauri.app",
    "BETTER_AUTH_URL": "https://nauri.app",
    "MAIL_FROM": "Nauri <nao-responda@nauri.app>",
    "SIGNUP_MODE": "invite"
  },

  // Sincronização do Open Finance, de hora em hora (minuto 17, fora do pico
  // da virada de hora). Sem os segredos do Open Finance ela não faz nada.
  "triggers": { "crons": ["17 * * * *"] }
  // O rate limit de login e cadastro é o do Better Auth, com a contagem no
  // banco (lib/auth.ts). O binding da Cloudflare contava por data center, de
  // forma aproximada, e deixava passar dezenas de tentativas.
}
