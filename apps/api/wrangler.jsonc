{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbital-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // better-auth usa APIs de Node (crypto, buffer) por baixo.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        // 10 tentativas por minuto por IP: folgado para quem erra a senha,
        // apertado para quem está testando lista de senhas.
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  }
}
